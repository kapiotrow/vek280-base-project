# base.cfg.in -- v++ linker configuration TEMPLATE.
#
# THIS IS A TEMPLATE, NOT THE CONFIG. The Makefile generates
# build/<target>/base.cfg from it, substituting @PROJECT_ROOT@.
#
# Why: v++ requires an ABSOLUTE path for userPostSysLinkOverlayTcl. Writing one
# into a committed file is how a project stops building on anyone else's
# machine -- the reference project this is derived from has /home/<someone>/...
# in its linker config to this day.
#
# PHASE 2 topology -- the AI Engine is in the datapath:
#
#   data_src_0 --AXIS--> ai_engine_0.StreamIn
#                            echo_kernel
#   data_sink_0 <--AXIS-- ai_engine_0.StreamOut
#
# Phase 0/1's direct data_src -> data_sink connection is gone.

[connectivity]
nk=data_src:1:data_src_0
nk=data_sink:1:data_sink_0

# PLIO connections.
#
# THE NAMES AFTER ai_engine_0. ARE THE PLIO NAMES FROM THE GRAPH, and this is
# the project's one cross-file string contract:
#
#     design/aie_src/base_graph.h:  input_plio::create("StreamIn", ...)
#     this file:                    ...:ai_engine_0.StreamIn
#
# A typo is not an error in either file. It is a connection that silently does
# not exist, and therefore a deadlock with no diagnostic. If a PLIO design hangs
# and you have not changed anything else, check these four strings first.
#
# The left-hand sides are the HLS argument names of the AXIS ports.
stream_connect=data_src_0.out:ai_engine_0.StreamIn
stream_connect=ai_engine_0.StreamOut:data_sink_0.in

# Memory banks.
#
# THE VEK280 HAS LPDDR4, NOT DDR. Its memory sptags are LPDDR1 and LPDDR2; an
# sp= line naming DDR fails to link on this platform, and copying a config from
# a VCK190 example is the usual way to meet that error.
#
# The left-hand side references the m_axi ARGUMENT name (in, out) -- not the
# HLS bundle name (gmem). Naming the bundle is accepted in some tool versions
# and ignored in others.
sp=data_src_0.in:LPDDR1
sp=data_sink_0.out:LPDDR1

[advanced]
param=hw_emu.enableProfiling=false

# Raises the AIE array clock to 1 GHz. The kernel cycle figures this project
# quotes are all against 1 GHz.
param=compiler.userPostSysLinkOverlayTcl=@PROJECT_ROOT@/design/directives/post_sys_link.tcl
